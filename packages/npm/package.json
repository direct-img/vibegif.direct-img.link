{
  "name": "vibegif",
  "version": "0.2.0",
  "description": "Search vibegif's public domain animated webp/gifs and get hotlinkable URLs",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "types": "./index.d.ts",
  "bin": {
    "vibegif": "cli.js"
  },
  "files": [
